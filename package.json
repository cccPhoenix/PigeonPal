{
  "name": "pigeonpal",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python scripts/serve.py",
    "test": "node --test tests/*.test.mjs",
    "test:updates": "node build/smoke_updates.cjs",
    "release:verify": "node build/release.cjs verify",
    "crawler": "python scripts/pigeonpal_crawler.py run",
    "crawler:once": "python scripts/pigeonpal_crawler.py run --once",
    "crawler:status": "python scripts/pigeonpal_crawler.py status",
    "desktop": "electron .",
    "build:backend": "python build/build_backend.py",
    "dist:win": "npm run build:backend && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build:backend && electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "description": "鸽友：本地校园伙伴、校园通知与提醒",
  "author": "PigeonPal contributors",
  "dependencies": {
    "electron-updater": "6.8.12",
    "semver": "7.8.5"
  }
}
